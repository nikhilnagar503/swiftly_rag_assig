{
  "name": "swiftly-rag-assig",
  "version": "1.0.0",
  "description": "Simple RAG pipeline (upload PDF/TXT/MD -> chunk -> embed -> vector store -> retrieve -> answer) in one TypeScript file",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
